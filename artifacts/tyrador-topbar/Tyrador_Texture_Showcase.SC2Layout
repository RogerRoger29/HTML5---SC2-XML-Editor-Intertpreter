<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<Desc>
    <!-- Temporary visual reference used while designing the Tyrador top bar. -->
    <Frame type="Frame" name="TyradorTextureShowcase">
        <Width val="1100"/>
        <Height val="760"/>
        <Anchor side="Top" relative="$parent" pos="Min" offset="80"/>
        <Anchor side="Left" relative="$parent" pos="Mid" offset="-550"/>

        <Frame type="Image" name="Backdrop">
            <Anchor relative="$parent"/>
            <Texture val="Assets/Textures/White.dds"/>
            <Color val="10,12,18"/>
        </Frame>

        <Frame type="Image" name="CommandPanel">
            <Anchor side="Top" relative="$parent" pos="Min" offset="20"/>
            <Anchor side="Left" relative="$parent" pos="Min" offset="20"/>
            <Width val="800"/>
            <Height val="500"/>
            <Texture val="Assets/Textures/ui_console_panel_command_tyrador.dds"/>
        </Frame>

        <Frame type="Image" name="MenuBar">
            <Anchor side="Top" relative="$parent" pos="Min" offset="540"/>
            <Anchor side="Left" relative="$parent" pos="Min" offset="20"/>
            <Width val="241"/>
            <Height val="56"/>
            <Texture val="Assets/Textures/ui_console_menubar_background_tyrador.dds"/>
        </Frame>

        <Frame type="Image" name="ChatBar">
            <Anchor side="Top" relative="$parent" pos="Min" offset="20"/>
            <Anchor side="Left" relative="$parent" pos="Min" offset="840"/>
            <Width val="216"/>
            <Height val="320"/>
            <Texture val="Assets/Textures/ui_console_chatbar_background_tyrador.dds"/>
        </Frame>

        <Frame type="Image" name="Timer">
            <Anchor side="Top" relative="$parent" pos="Min" offset="360"/>
            <Anchor side="Left" relative="$parent" pos="Min" offset="840"/>
            <Width val="88"/>
            <Height val="88"/>
            <Texture val="Assets/Textures/ui_console_timer_background_tyrador.dds"/>
        </Frame>

        <Frame type="Image" name="Helper">
            <Anchor side="Top" relative="$parent" pos="Min" offset="360"/>
            <Anchor side="Left" relative="$parent" pos="Min" offset="950"/>
            <Width val="92"/>
            <Height val="62"/>
            <Texture val="Assets/Textures/ui_console_helperbutton_background_tyrador.dds"/>
        </Frame>

        <Frame type="Image" name="CommandButtonNormal">
            <Anchor side="Top" relative="$parent" pos="Min" offset="620"/>
            <Anchor side="Left" relative="$parent" pos="Min" offset="20"/>
            <Width val="76"/>
            <Height val="76"/>
            <Texture val="Assets/Textures/ui_console_commandbutton_normal_tyrador.dds"/>
        </Frame>

        <Frame type="Image" name="CommandButtonHighlighted">
            <Anchor side="Top" relative="$parent" pos="Min" offset="620"/>
            <Anchor side="Left" relative="$parent" pos="Min" offset="116"/>
            <Width val="76"/>
            <Height val="76"/>
            <Texture val="Assets/Textures/ui_console_commandbutton_highlighted_tyrador.dds"/>
        </Frame>

        <Frame type="Image" name="CommandButtonSuperHighlighted">
            <Anchor side="Top" relative="$parent" pos="Min" offset="620"/>
            <Anchor side="Left" relative="$parent" pos="Min" offset="212"/>
            <Width val="76"/>
            <Height val="76"/>
            <Texture val="Assets/Textures/ui_console_commandbutton_superhighlighted_tyrador.dds"/>
        </Frame>
    </Frame>
</Desc>
