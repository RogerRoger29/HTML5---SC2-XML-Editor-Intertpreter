//--------------------------------------------------------------------------------------------------
bool gt_AuthorEnableCalltoArmsSession_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    unitgroup auto7AE46508_g;
    int auto7AE46508_u;
    unit auto7AE46508_var;

    // Actions
    if (!runActions) {
        return true;
    }

    libNtve_gf_SetUpgradeLevelForPlayer(1, "SOAWarpInReinforcements", 1);
    libNtve_gf_SetUpgradeLevelForPlayer(1, "SOAProxyPylon", 0);
    libVoiC_gf_EnableDisableSpearofAdunAbility(true, "GPTier1Power3");
    BankLoad(libCC65E7BC_gv_bankName, 1);
    BankValueSetFromFlag(libCC65E7BC_gv_knightsBank, libCC65E7BC_gv_permaUpgrades, libCC65E7BC_gv_salvagedBotsAllied, true);
    BankValueSetFromFlag(libCC65E7BC_gv_knightsBank, libCC65E7BC_gv_storyChoices, libCC65E7BC_gv_weretheCivilianssavedonMarSara, true);
    BankValueSetFromFlag(libCC65E7BC_gv_knightsBank, libCC65E7BC_gv_storyChoices, libCC65E7BC_gv_shakurasSaved, true);
    BankValueSetFromFlag(libCC65E7BC_gv_knightsBank, libCC65E7BC_gv_storyChoices, libCC65E7BC_gv_nerazimSavedonShakuras01, true);
    BankValueSetFromFlag(libCC65E7BC_gv_knightsBank, libCC65E7BC_gv_permaUnits, libCC65E7BC_gv_simmonsUnlock, true);
    auto7AE46508_g = UnitGroup("KoEGlobalCaster", c_playerAny, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32))), 0);
    auto7AE46508_u = UnitGroupCount(auto7AE46508_g, c_unitCountAll);
    for (;; auto7AE46508_u -= 1) {
        auto7AE46508_var = UnitGroupUnitFromEnd(auto7AE46508_g, auto7AE46508_u);
        if (auto7AE46508_var == null) { break; }
        UnitIssueOrder(auto7AE46508_var, OrderTargetingPoint(AbilityCommand("CalltoArms", 0), PointFromId(473297419)), c_orderQueueReplace);
    }
    return true;
}

