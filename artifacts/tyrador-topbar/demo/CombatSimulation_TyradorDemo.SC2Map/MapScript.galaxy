//--------------------------------------------------------------------------------------------------
bool gt_PauseOpponentWaves_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    TriggerEnable(gt_WaveTerran, false);
    TriggerEnable(gt_WaveZerg, false);
    TriggerEnable(gt_WaveProtoss, false);
    TriggerEnable(gt_WaveUnbound, false);
    TriggerEnable(gt_EnableOGEndlessWavesonSelection, false);
    TriggerEnable(gt_WaveOGEndless, false);
