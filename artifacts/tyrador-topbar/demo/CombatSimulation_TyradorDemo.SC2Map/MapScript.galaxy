//--------------------------------------------------------------------------------------------------
// Trigger: Handle Simulation Console Clicks
//--------------------------------------------------------------------------------------------------
bool gt_HandleSimulationConsoleClicks_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_clickedConsoleChoiceIndex;

    // Automatic Variable Declarations
    const int autoC5100F50_ae = 25;
    const int autoC5100F50_ai = 1;
    const int autoC5100F5E_ae = 17;
    const int autoC5100F5E_ai = 1;

    // Variable Initialization

    // Conditions
    if (testConds) {
        if (!((EventPlayer() == 1))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    if ((EventDialogControl() == gv_openConsoleButton)) {
        gf_RefreshSimulationConsole();
        gf_ShowSimulationConsoleMain();
    }

    if ((EventDialogControl() == gv_closeConsoleButton)) {
        gf_ShowSimulationConsoleLauncher();
    }

    if ((EventDialogControl() == gv_openWarCouncilButton)) {
        gf_RefreshWarCouncilConsole();
        gf_ShowSimulationConsoleWarCouncil();
    }

    if ((EventDialogControl() == gv_openSolarCoreButton)) {
        gf_RefreshSolarCoreConsole();
        gf_ShowSimulationConsoleSolarCore();
    }

    if ((EventDialogControl() == gv_warCouncilBackButton)) {
        gf_ShowSimulationConsoleMain();
    }

    if ((EventDialogControl() == gv_solarCoreBackButton)) {
        gf_ShowSimulationConsoleMain();
    }

    if ((EventDialogControl() == gv_consoleResourcesButton)) {
        TriggerExecute(gt_RefillPlayerResources, true, false);
    }

    if ((EventDialogControl() == gv_consoleRestoreButton)) {
        TriggerExecute(gt_RestoreSelectedUnits, true, false);
    }

    if ((EventDialogControl() == gv_consoleWavesOffButton)) {
        TriggerExecute(gt_PauseOpponentWaves, true, false);
    }

    if ((EventDialogControl() == gv_consoleStandardWavesButton)) {
        TriggerExecute(gt_ResumeStandardOpponentWaves, true, false);
    }

    if ((EventDialogControl() == gv_consoleAllWavesButton)) {
        TriggerExecute(gt_EnableAllOpponentWaves, true, false);
    }

    if ((EventDialogControl() == gv_consoleReapplyLoadoutButton)) {
        gf_RestoreCampaignLoadout();
        UIDisplayMessage(PlayerGroupSingle(1), c_messageAreaChat, StringToText("Campaign loadout reapplied for this session."));
    }

    if (((EventDialogControl() == gv_consoleReloadProgressButton) && (gv_authorLabEnabled == true))) {
        TriggerExecute(gt_AuthorReloadCampaignProgression, true, false);
    }

    lv_clickedConsoleChoiceIndex = 0;
    for ( ; ( (autoC5100F50_ai >= 0 && lv_clickedConsoleChoiceIndex <= autoC5100F50_ae) || (autoC5100F50_ai < 0 && lv_clickedConsoleChoiceIndex >= autoC5100F50_ae) ) ; lv_clickedConsoleChoiceIndex += autoC5100F50_ai ) {
        if ((EventDialogControl() == gv_warCouncilChoiceButtons[lv_clickedConsoleChoiceIndex])) {
            gf_ApplyWarCouncilSessionChoice(lv_clickedConsoleChoiceIndex);
        }

    }
    lv_clickedConsoleChoiceIndex = 0;
    for ( ; ( (autoC5100F5E_ai >= 0 && lv_clickedConsoleChoiceIndex <= autoC5100F5E_ae) || (autoC5100F5E_ai < 0 && lv_clickedConsoleChoiceIndex >= autoC5100F5E_ae) ) ; lv_clickedConsoleChoiceIndex += autoC5100F5E_ai ) {
        if ((EventDialogControl() == gv_solarCoreChoiceButtons[lv_clickedConsoleChoiceIndex])) {
            gf_ApplySolarCoreSessionChoice(lv_clickedConsoleChoiceIndex);
        }

    }
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_HandleSimulationConsoleClicks_Init () {
    gt_HandleSimulationConsoleClicks = TriggerCreate("gt_HandleSimulationConsoleClicks_Func");
    TriggerAddEventDialogControl(gt_HandleSimulationConsoleClicks, c_playerAny, c_invalidDialogControlId, c_triggerControlEventTypeClick);
}

