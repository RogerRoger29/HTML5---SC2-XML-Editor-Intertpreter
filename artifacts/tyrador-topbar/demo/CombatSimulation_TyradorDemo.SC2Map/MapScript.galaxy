//--------------------------------------------------------------------------------------------------
// Trigger: Enable OG Endless Waves on Selection
//--------------------------------------------------------------------------------------------------
bool gt_EnableOGEndlessWavesonSelection_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    unitgroup autoF047AFF2_g;
    int autoF047AFF2_u;
    unit autoF047AFF2_var;

    // Conditions
    if (testConds) {
        if (!((UnitGetOwner(EventUnit()) == gv_pLAYER_06_ENDLESS))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    autoF047AFF2_g = UnitGroup(null, gv_pLAYER_06_ENDLESS, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    autoF047AFF2_u = UnitGroupCount(autoF047AFF2_g, c_unitCountAll);
    for (;; autoF047AFF2_u -= 1) {
        autoF047AFF2_var = UnitGroupUnitFromEnd(autoF047AFF2_g, autoF047AFF2_u);
        if (autoF047AFF2_var == null) { break; }
        UnitClearInfoText(autoF047AFF2_var);
    }
    TriggerEnable(TriggerGetCurrent(), false);
    TriggerEnable(gt_WaveOGEndless, true);
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_EnableOGEndlessWavesonSelection_Init () {
    gt_EnableOGEndlessWavesonSelection = TriggerCreate("gt_EnableOGEndlessWavesonSelection_Func");
    TriggerAddEventUnitSelected(gt_EnableOGEndlessWavesonSelection, null, c_playerAny, true);
}

