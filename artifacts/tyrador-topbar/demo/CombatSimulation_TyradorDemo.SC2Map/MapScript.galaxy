//--------------------------------------------------------------------------------------------------
bool gt_DisableAuthorTools_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    gv_authorLabEnabled = false;
    TriggerEnable(gt_AuthorInitializeAMTTopbar, false);
    TriggerEnable(gt_AuthorEnableKnightBankCheatSession, false);
    TriggerEnable(gt_AuthorCheckKnightBankCheat, false);
    TriggerEnable(gt_AuthorEnableAdditionalUnits, false);
    TriggerEnable(gt_AuthorSpawnAbominationTest, false);
    TriggerEnable(gt_AuthorTraceNarudHybridBehaviors, false);
    TriggerEnable(gt_AuthorGenerateSubtitleTest, false);
    TriggerEnable(gt_AuthorEnableSolaceAmongRuins, false);
    TriggerEnable(gt_AuthorEnableShatteredReality, false);
    TriggerEnable(gt_AuthorEnableCalltoArmsSession, false);
    TriggerEnable(gt_AuthorEnableTemporalField, false);
    TriggerEnable(gt_AuthorEnableChronoSurge, false);
    TriggerEnable(gt_AuthorEnableEnhancedLogisticalProtocols, false);
    TriggerEnable(gt_AuthorEnableAIChaseReinforcements, false);
    TriggerEnable(gt_AuthorAddRevitalizerXP, false);
    TriggerEnable(gt_AuthorLoadTunnelConvoyUnits, false);
    TriggerEnable(gt_AuthorClearTunnelConvoyBankSection, false);
    TriggerEnable(gt_AuthorReloadCampaignProgression, false);
    gf_RestoreCampaignLoadout();
    UIDisplayMessage(PlayerGroupSingle(1), c_messageAreaChat, StringToText("Author tools disabled. Campaign loadout restored."));
    return true;
}

