//--------------------------------------------------------------------------------------------------
// Trigger: DFA Reclamation Casualty
//--------------------------------------------------------------------------------------------------
bool gt_DFAReclamationCasualty_Func (bool testConds, bool runActions) {
    // Variable Declarations
    unit lv_dFAReclamationDeadUnit;
    string lv_dFAReclamationDeadType;
    int lv_dFAReclamationDeadOwner;
    point lv_dFAReclamationDeadPosition;

    // Automatic Variable Declarations
    // Variable Initialization

    // Conditions
    if (testConds) {
        if (!((UnitBehaviorCount(EventUnit(), "DFAReclamationEligible") >= 1))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    lv_dFAReclamationDeadUnit = EventUnit();
    lv_dFAReclamationDeadType = UnitGetType(lv_dFAReclamationDeadUnit);
    lv_dFAReclamationDeadOwner = UnitGetOwner(lv_dFAReclamationDeadUnit);
    lv_dFAReclamationDeadPosition = UnitGetPosition(lv_dFAReclamationDeadUnit);
    if ((lv_dFAReclamationDeadType == "DFAConstructionVehicle")) {
        UnitCreate(1, "DFAWreckConstructionVehicle", c_unitCreateIgnorePlacement, lv_dFAReclamationDeadOwner, lv_dFAReclamationDeadPosition, 0.0);
    }
    else {
        if ((lv_dFAReclamationDeadType == "DFAFortressMCV")) {
            UnitCreate(1, "DFAWreckFortressMCV", c_unitCreateIgnorePlacement, lv_dFAReclamationDeadOwner, lv_dFAReclamationDeadPosition, 0.0);
        }
        else {
            if ((lv_dFAReclamationDeadType == "DFAFortressMCVMobile")) {
                UnitCreate(1, "DFAWreckFortressMCV", c_unitCreateIgnorePlacement, lv_dFAReclamationDeadOwner, lv_dFAReclamationDeadPosition, 0.0);
            }
            else {
                if ((lv_dFAReclamationDeadType == "DFAUndergroundBunker")) {
                    UnitCreate(1, "DFAWreckUndergroundBunker", c_unitCreateIgnorePlacement, lv_dFAReclamationDeadOwner, lv_dFAReclamationDeadPosition, 0.0);
                }
                else {
                    if ((lv_dFAReclamationDeadType == "DFAMovingBunker")) {
                        UnitCreate(1, "DFAWreckMovingBunker", c_unitCreateIgnorePlacement, lv_dFAReclamationDeadOwner, lv_dFAReclamationDeadPosition, 0.0);
                    }
                    else {
                        if ((lv_dFAReclamationDeadType == "DFAMovingBunkerBurrowed")) {
                            UnitCreate(1, "DFAWreckMovingBunker", c_unitCreateIgnorePlacement, lv_dFAReclamationDeadOwner, lv_dFAReclamationDeadPosition, 0.0);
                        }
                        else {
                            if ((lv_dFAReclamationDeadType == "DFARefinery")) {
                                UnitCreate(1, "DFAWreckRefinery", c_unitCreateIgnorePlacement, lv_dFAReclamationDeadOwner, lv_dFAReclamationDeadPosition, 0.0);
                            }
                            else {
                                if ((lv_dFAReclamationDeadType == "DFAInfantryDepot")) {
                                    UnitCreate(1, "DFAWreckInfantryDepot", c_unitCreateIgnorePlacement, lv_dFAReclamationDeadOwner, lv_dFAReclamationDeadPosition, 0.0);
                                }
                                else {
                                    if ((lv_dFAReclamationDeadType == "DFAMobileFactory")) {
                                        UnitCreate(1, "DFAWreckMobileFactory", c_unitCreateIgnorePlacement, lv_dFAReclamationDeadOwner, lv_dFAReclamationDeadPosition, 0.0);
                                    }
                                    else {
                                        if ((lv_dFAReclamationDeadType == "DFAMobileFactoryMobile")) {
                                            UnitCreate(1, "DFAWreckMobileFactory", c_unitCreateIgnorePlacement, lv_dFAReclamationDeadOwner, lv_dFAReclamationDeadPosition, 0.0);
                                        }
                                        else {
                                            if ((lv_dFAReclamationDeadType == "DFAVulturePatrol")) {
                                                UnitCreate(1, "DFAWreckVulturePatrol", c_unitCreateIgnorePlacement, lv_dFAReclamationDeadOwner, lv_dFAReclamationDeadPosition, 0.0);
                                            }
                                            else {
                                                if ((lv_dFAReclamationDeadType == "DFAStoneGoose")) {
                                                    UnitCreate(1, "DFAWreckStoneGoose", c_unitCreateIgnorePlacement, lv_dFAReclamationDeadOwner, lv_dFAReclamationDeadPosition, 0.0);
                                                }
                                                else {
                                                    if ((lv_dFAReclamationDeadType == "DFAStoneGooseBraced")) {
                                                        UnitCreate(1, "DFAWreckStoneGoose", c_unitCreateIgnorePlacement, lv_dFAReclamationDeadOwner, lv_dFAReclamationDeadPosition, 0.0);
                                                    }
                                                    else {
                                                        if ((lv_dFAReclamationDeadType == "DFATransportTruck")) {
                                                            UnitCreate(1, "DFAWreckTransportTruck", c_unitCreateIgnorePlacement, lv_dFAReclamationDeadOwner, lv_dFAReclamationDeadPosition, 0.0);
                                                        }
                                                        else {
                                                            if ((lv_dFAReclamationDeadType == "DFATransportTruckDeployed")) {
                                                                UnitCreate(1, "DFAWreckTransportTruck", c_unitCreateIgnorePlacement, lv_dFAReclamationDeadOwner, lv_dFAReclamationDeadPosition, 0.0);
                                                            }

                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_DFAReclamationCasualty_Init () {
    gt_DFAReclamationCasualty = TriggerCreate("gt_DFAReclamationCasualty_Func");
    TriggerAddEventUnitDied(gt_DFAReclamationCasualty, null);
}

//--------------------------------------------------------------------------------------------------
// Trigger: MSC Shoulder Salvo Fired
//--------------------------------------------------------------------------------------------------
bool gt_MSCShoulderSalvoFired_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((UnitGetType(EventUnit()) == "KoEMechaScorpalisk"))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    gf_MSCRunPursuitSalvo(EventUnit(), EventUnitTargetUnit());
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_MSCShoulderSalvoFired_Init () {
    gt_MSCShoulderSalvoFired = TriggerCreate("gt_MSCShoulderSalvoFired_Func");
    TriggerAddEventUnitAbility(gt_MSCShoulderSalvoFired, null, AbilityCommand("KoEMechaScorpaliskShoulderAbility", 0), c_unitAbilStageComplete, false);
}

//--------------------------------------------------------------------------------------------------
// Tyrador top bar demonstration
//--------------------------------------------------------------------------------------------------
bool gt_TyradorTopBarCreate_Func (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }

    // The Combat Simulation bank can legitimately have no tier-3 passive
    // selected. Give the visual demo one real KoE passive after bank loading;
    // the production integration continues to use the player's bank choice.
    libNtve_gf_SetUpgradeLevelForPlayer(1, "BattlefieldAdaptation", 0);
    libNtve_gf_SetUpgradeLevelForPlayer(1, "EnhancedLogisticalProtocols", 0);
    libNtve_gf_SetUpgradeLevelForPlayer(1, "FrontlineProtocolUpgrade", 1);
    libNtve_gf_SetDialogItemUnitGroup(
        libB513D0A0_gv_aMTTopBarTopBarCommandCard[1],
        libB513D0A0_gv_aMTTopBarGlobalCasterGroup[1],
        PlayerGroupSingle(1)
    );
    libB513D0A0_gf_SetTopBarGlobalCasterEnergyForPlayer(1, 225.0, libB513D0A0_ge_EnergyType_Absolute);
    return true;
}

void gt_TyradorTopBarCreate_Init () {
    TriggerDebugOutputEnable(true);
    TriggerDebugEnableType(7, true);
    TriggerDebugSetTypeName(7, StringToText("TYRADOR TOP BAR"));
    TriggerDebugSetTypeFile(7, "TyradorTopBarDemo.txt");
    TriggerDebugOutput(7, StringToText("Create trigger armed; waiting for KoEGlobalCaster."), false);
    gt_TyradorTopBarCreate = TriggerCreate("gt_TyradorTopBarCreate_Func");
    TriggerAddEventTimeElapsed(gt_TyradorTopBarCreate, 2.0, c_timeGame);
}

bool gt_TyradorTopBarUpdate_Func (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }
    gf_TyradorTopBarUpdate();
    return true;
}

void gt_TyradorTopBarUpdate_Init () {
    gt_TyradorTopBarUpdate = TriggerCreate("gt_TyradorTopBarUpdate_Func");
    TriggerAddEventTimePeriodic(gt_TyradorTopBarUpdate, 0.0625, c_timeReal);
}

