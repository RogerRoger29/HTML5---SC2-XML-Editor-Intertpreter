    // Actions
    if (!runActions) {
        return true;
    }

    autoC5100D9C_g = UnitGroupSelected(1);
    autoC5100D9C_u = UnitGroupCount(autoC5100D9C_g, c_unitCountAll);
    for (;; autoC5100D9C_u -= 1) {
        autoC5100D9C_var = UnitGroupUnitFromEnd(autoC5100D9C_g, autoC5100D9C_u);
        if (autoC5100D9C_var == null) { break; }
        UnitSetPropertyFixed(autoC5100D9C_var, c_unitPropLifePercent, 100.0);
        UnitSetPropertyFixed(autoC5100D9C_var, c_unitPropShieldsPercent, 100.0);
        UnitSetPropertyFixed(autoC5100D9C_var, c_unitPropEnergyPercent, 100.0);
    }
    UIDisplayMessage(PlayerGroupSingle(1), c_messageAreaChat, StringToText("Selected units restored."));
    return true;
}

