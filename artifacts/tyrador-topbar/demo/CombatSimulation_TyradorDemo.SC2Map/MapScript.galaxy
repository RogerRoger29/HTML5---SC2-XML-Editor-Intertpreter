//--------------------------------------------------------------------------------------------------
// Trigger: Enable Author Tools
//--------------------------------------------------------------------------------------------------
bool gt_EnableAuthorTools_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    gv_authorLabEnabled = true;
    TriggerEnable(gt_AuthorInitializeAMTTopbar, true);
    TriggerEnable(gt_AuthorEnableKnightBankCheatSession, true);
    TriggerEnable(gt_AuthorCheckKnightBankCheat, true);
    TriggerEnable(gt_AuthorEnableAdditionalUnits, true);
    TriggerEnable(gt_AuthorSpawnAbominationTest, true);
    TriggerEnable(gt_AuthorTraceNarudHybridBehaviors, true);
    TriggerEnable(gt_AuthorGenerateSubtitleTest, true);
    TriggerEnable(gt_AuthorEnableSolaceAmongRuins, true);
    TriggerEnable(gt_AuthorEnableShatteredReality, true);
    TriggerEnable(gt_AuthorEnableCalltoArmsSession, true);
    TriggerEnable(gt_AuthorEnableTemporalField, true);
    TriggerEnable(gt_AuthorEnableChronoSurge, true);
    TriggerEnable(gt_AuthorEnableEnhancedLogisticalProtocols, true);
    TriggerEnable(gt_AuthorEnableAIChaseReinforcements, true);
    TriggerEnable(gt_AuthorAddRevitalizerXP, true);
    TriggerEnable(gt_AuthorLoadTunnelConvoyUnits, true);
    TriggerEnable(gt_AuthorClearTunnelConvoyBankSection, true);
    TriggerEnable(gt_AuthorReloadCampaignProgression, true);
    gf_RefreshSimulationConsole();
    UIDisplayMessage(PlayerGroupSingle(1), c_messageAreaChat, StringToText("Author tools enabled. The Simulation Console now exposes the full implemented roster."));
    UIDisplayMessage(PlayerGroupSingle(1), c_messageAreaChat, StringToText("Use -progress reload or -lab off. Legacy tests remain available for this session."));
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_EnableAuthorTools_Init () {
    gt_EnableAuthorTools = TriggerCreate("gt_EnableAuthorTools_Func");
    TriggerAddEventChatMessage(gt_EnableAuthorTools, 1, "-lab on", true);
}

