unit gf_TyradorTopBarFindCaster () {
    unitgroup lv_candidates;
    int lv_count;

    lv_candidates = UnitGroup("KoEGlobalCaster", c_playerAny, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32))), 0);
    lv_count = UnitGroupCount(lv_candidates, c_unitCountAll);
    if ((lv_count <= 0)) {
        return null;
    }
    return UnitGroupUnitFromEnd(lv_candidates, lv_count);
}

void gf_TyradorTopBarUpdate () {
    fixed lv_energy;
    fixed lv_energyPercent;
    fixed lv_segmentValue;
    int lv_index;
    playergroup lv_player;

    if ((gv_tyradorCaster == null) || (gv_tyradorTopBarPanel == c_invalidDialogControlId)) {
        return;
    }

    lv_player = PlayerGroupSingle(1);
    lv_energy = MaxF(0.0, UnitGetPropertyFixed(gv_tyradorCaster, c_unitPropEnergy, c_unitPropCurrent));
    lv_energyPercent = MaxF(0.0, MinF(100.0, UnitGetPropertyFixed(gv_tyradorCaster, c_unitPropEnergyPercent, c_unitPropCurrent)));
    lv_index = 0;
    while ((lv_index < 10)) {
        lv_segmentValue = MaxF(0.0, MinF(100.0, (lv_energyPercent - IntToFixed(lv_index * 10)) * 10.0));
        libNtve_gf_SetDialogItemCurrentValue(gv_tyradorEnergySegments[lv_index], lv_segmentValue, lv_player);
        lv_index += 1;
    }
    libNtve_gf_SetDialogItemText(gv_tyradorEnergyLabel, IntToText(FixedToInt(Floor(lv_energy))), lv_player);
}

void gf_ShowSimulationConsoleLauncher () {
