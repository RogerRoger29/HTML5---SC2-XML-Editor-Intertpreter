// Knights of Tyrador top bar integration reference for KoE + AMT.
//
// TyradorTopBar.SC2Mod contributes the AMTTopBarTemplate user-data instance
// named "Tyrador". AMT still owns creation, the command-panel binding, caster
// storage, targeting UI, cinematic handling, and energy updates.

void TyradorTopBarInitializeForPlayer (int player) {
    // This is the only top-bar creation call. Do not also initialize
    // "SpearOfAdun" for the same player because AMT intentionally accepts the
    // first template once and ignores later initialization calls.
    // KoE's normal bank/perk setup remains authoritative for which overlapping
    // command-card choices become visible.
    libB513D0A0_gf_InitTopBarForPlayer(player, "Tyrador");
}
